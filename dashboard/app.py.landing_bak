# ============================================================
# MODULE 2 — TOPOLOGICAL ROAD HEALING (RAW VS HEALED MASK)
# ============================================================
elif active_tab == "Topological Road Healing":
    st.markdown("### Topological Road Healing & Occlusion Recovery")
    st.markdown(
        "Compare raw neural segmentation outputs against the topologically healed mask across "
        "the full **1677x1612** Bengaluru AOI at **10m/pixel ground resolution**."
    )

    st.markdown("""
    <div class="info-card">
        <b>What This Module Demonstrates:</b><br>
        Standard satellite models lose roads when tree canopies (e.g. along Bengaluru's avenues) or skyscraper shadows 
        block optical sensors. The <b>Raw Output</b> contains noisy gaps. The <b>Healed Mask</b> applies morphological closing, 
        small-object pruning, and directional vector healing to restore continuous, unbroken arterial corridors.
    </div>
    """, unsafe_allow_html=True)

    bounds = [
        [config.AOI["south"], config.AOI["west"]],
        [config.AOI["north"], config.AOI["east"]],
    ]

    col_raw, col_healed = st.columns(2)

    raw_url, raw_pixels, h_raw, w_raw = _load_mask_overlay("pred_mask.npy", (255, 50, 50, 235))
    healed_url, healed_pixels, h_heal, w_heal = _load_mask_overlay("healed_mask.npy", (0, 230, 118, 235))

    with col_raw:
        st.markdown("#### Raw Segmentation Output (With Occlusion Gaps)")
        m_raw = folium.Map(
            location=[config.AOI["center_lat"], config.AOI["center_lon"]],
            zoom_start=config.MAP_ZOOM_START,
            tiles=config.ESRI_TILES,
            attr="Esri World Imagery",
        )
        folium.raster_layers.ImageOverlay(
            image=raw_url,
            bounds=bounds,
            opacity=0.88,
            name="Raw Mask",
        ).add_to(m_raw)
        folium.LayerControl().add_to(m_raw)
        st_folium(m_raw, height=460, width="stretch", returned_objects=[], key="map_raw_real")
        st.caption(f"Raw neural detection: {raw_pixels:,} pixels. Notice discontinuities along tree avenues.")

    with col_healed:
        st.markdown("#### Topologically Healed Mask (Continuous Corridors)")
        m_healed = folium.Map(
            location=[config.AOI["center_lat"], config.AOI["center_lon"]],
            zoom_start=config.MAP_ZOOM_START,
            tiles=config.ESRI_TILES,
            attr="Esri World Imagery",
        )
        folium.raster_layers.ImageOverlay(
            image=healed_url,
            bounds=bounds,
            opacity=0.88,
            name="Healed Mask",
        ).add_to(m_healed)
        folium.LayerControl().add_to(m_healed)
        st_folium(m_healed, height=460, width="stretch", returned_objects=[], key="map_healed_real")
        st.caption(f"Healed output: {healed_pixels:,} pixels. Topological gaps bridged; sensor noise removed.")

    # Mask Metrics
    st.markdown("<div class='section-divider'></div>", unsafe_allow_html=True)
    st.markdown("#### Extraction & Healing Quality Indices")
    tab1_m = _load_mask_comparison_metrics()
    m1, m2, m3, m4 = st.columns(4)
    m1.metric("IoU Similarity", f"{tab1_m['iou']:.4f}", help="Intersection over Union agreement")
    m2.metric("Dice / F1 Score", f"{tab1_m['dice']:.4f}", help="Harmonic mean of precision and recall")
    m3.metric("Raw Road Pixels", f"{tab1_m['raw_pixels']:,}")
    m4.metric(
        "Healed Road Pixels",
        f"{tab1_m['healed_pixels']:,}",
        delta=f"{tab1_m['healed_pixels'] - tab1_m['raw_pixels']:,} (Noise Pruned)",
    )


# ============================================================
# MODULE 3 — CRITICALITY & GATEKEEPER HEATMAP
# ============================================================
elif active_tab == "Criticality & Gatekeeper Heatmap":
    st.markdown("### Network Criticality & Strategic Gatekeeper Heatmap")
    st.markdown(
        "Betweenness centrality modeling on Bengaluru's real 45,148-node road network. "
        "Roads and junctions are color-coded by how vital they are to city-wide traffic movement."
    )

    st.markdown("""
    <div class="info-card">
        <b>What is Betweenness Centrality?</b><br>
        Betweenness Centrality measures the percentage of shortest paths between all pairs of locations in Bengaluru 
        that must traverse a specific road or intersection. 
        <b>Red & Purple corridors</b> represent arterial lifelines. <b>Gatekeeper Nodes (marked with stars)</b> 
        are urban single points of failure where an obstruction paralyzes multi-quadrant connectivity.
    </div>
    """, unsafe_allow_html=True)

    G, cent = _load_real_graph()
    edge_coords, top_gks, cent_min, cent_max, num_gks = _get_criticality_display_data()

    m_crit = folium.Map(
        location=[config.AOI["center_lat"], config.AOI["center_lon"]],
        zoom_start=config.MAP_ZOOM_START,
        tiles=config.ESRI_TILES,
        attr="Esri World Imagery",
    )

    colormap = cm.LinearColormap(
        ["#2ecc71", "#f39c12", "#e74c3c", "#8e44ad"],
        vmin=cent_min, vmax=cent_max,
        caption="Betweenness Centrality (Green: Local Road -> Purple: Critical Arterial)",
    )
    colormap.add_to(m_crit)

    edge_group = folium.FeatureGroup(name="Arterial Network")
    for locs, edge_cent, u_str, v_str in edge_coords:
        folium.PolyLine(
            locations=locs,
            color=colormap(edge_cent),
            weight=3.2,
            opacity=0.88,
            tooltip=f"Road {u_str}-{v_str} | Centrality: {edge_cent:.5f}",
        ).add_to(edge_group)
    edge_group.add_to(m_crit)

    gk_group = folium.FeatureGroup(name="Gatekeeper Bottlenecks (Top 100)")
    for lat_g, lon_g, n_id, c_val, deg_val in top_gks:
        folium.CircleMarker(
            location=[lat_g, lon_g],
            radius=6.5,
            color="#e74c3c",
            fill=True,
            fill_color="#f1c40f",
            fill_opacity=0.95,
            tooltip=f"Gatekeeper Node {n_id} | Centrality: {c_val:.4f}",
            popup=f"<b>Gatekeeper Node {n_id}</b><br>Centrality: {c_val:.5f}<br>Degree: {deg_val}",
        ).add_to(gk_group)
    gk_group.add_to(m_crit)

    folium.LayerControl().add_to(m_crit)
    st_folium(m_crit, height=540, width="stretch", returned_objects=[], key="map_crit_real")

    st.markdown("<div class='section-divider'></div>", unsafe_allow_html=True)
    st.markdown("#### Real Road Network Summary")
    s1, s2, s3, s4 = st.columns(4)
    s1.metric("Total Graph Nodes", f"{len(G.nodes()):,}")
    s2.metric("Total Graph Edges", f"{len(G.edges()):,}")
    s3.metric("Gatekeeper Nodes", f"{num_gks:,} (Top 5%)")
    s4.metric("Peak Centrality", f"{cent_max:.4f}")

    st.markdown("#### Top Strategic Gatekeeper Junctions (Critical Urban Chokepoints)")
    gk_table = []
    for lat_g, lon_g, n_id, c_val, deg_val in top_gks[:15]:
        gk_table.append({
            "Gatekeeper Node ID": n_id,
            "Betweenness Centrality": round(c_val, 5),
            "Connecting Arterials (Degree)": deg_val,
            "Latitude": round(lat_g, 5),
            "Longitude": round(lon_g, 5),
        })
    st.dataframe(pd.DataFrame(gk_table), width="stretch", hide_index=True)


# ============================================================
# MODULE 4 — DISASTER STRESS SIMULATOR (HIGH VISIBILITY & DEEP EXPLANATION)
# ============================================================
elif active_tab == "Disaster Stress Simulator":
    st.markdown("### Disaster Network Stress Test Simulator")
    st.markdown(
        "Simulate acute disaster disruptions, monsoon waterlogging, and structural bridge collapses "
        "on Bengaluru's real 45,148-node road network to observe fragmentation and hospital access loss."
    )

    st.markdown("""
    <div class="info-card">
        <b>How the Stress Simulator Works:</b><br>
        1. <b>Simulated Disruption:</b> When an extreme event strikes (e.g. Central Silk Board underpass flooding), 
        the critical road nodes are removed from the active graph.<br>
        2. <b>Network Fragmentation:</b> The simulator recomputes connected components to detect how many isolated 
        neighborhood islands were severed from the main city.<br>
        3. <b>Emergency Hospital Access:</b> It checks whether ambulances from disconnected zones can still reach 
        <b>Victoria Hospital (Apex Emergency Medical Hub)</b>.<br>
        4. <b>Detour Overhead:</b> It calculates the surge in travel hops and commute delay forced upon vehicles.
    </div>
    """, unsafe_allow_html=True)

    G_original, cent = _load_real_graph()

    DISASTER_SCENARIOS = {
        "Monsoon Inundation - Central Silk Board Interchange": {
            "description": "Severe monsoon flash floods submerge the Silk Board underpass and flyover approaches, cutting off Hosur Road and the Electronic City Expressway.",
            "landmark": config.LANDMARKS["silk_board_junction"],
            "impact_profile": "South-East technology corridor paralyzed. Heavy commercial and commuter isolation.",
        },
        "Structural Bridge Collapse - KR Puram Railway Bridge": {
            "description": "Major structural severance on Old Madras Road at the KR Puram cable bridge isolates the Whitefield ITPL corridor from Central Bengaluru.",
            "landmark": config.LANDMARKS["kr_puram_bridge"],
            "impact_profile": "East Bengaluru freight and tech commuters severed. High detour overhead.",
        },
        "Approach Blockage / Landslide - Hebbal Flyover": {
            "description": "Heavy rainfall causes road collapse and debris inundation on Bellary Road, paralyzing the northern gateway to Kempegowda International Airport.",
            "landmark": config.LANDMARKS["hebbal_flyover"],
            "impact_profile": "Northern expressway and airport transit corridor blocked.",
        },
        "Underpass Submergence - ORR-Sarjapur Junction": {
            "description": "Flash flooding traps vehicles in the Outer Ring Road underpass, cutting off the Bellandur-Sarjapur tech belt.",
            "landmark": config.LANDMARKS["outer_ring_road_junction"],
            "impact_profile": "Bellandur tech parks and residential sectors cut off from arterial ring road.",
        },
        "Multi-Point Cascade Disaster (Silk Board + ORR + KR Puram)": {
            "description": "Severe simultaneous cloudburst flood paralyzes Silk Board, Sarjapur, and KR Puram concurrently, inducing city-wide gridlock.",
            "landmark": config.LANDMARKS["silk_board_junction"],
            "multi_landmarks": [
                config.LANDMARKS["silk_board_junction"],
                config.LANDMARKS["outer_ring_road_junction"],
                config.LANDMARKS["kr_puram_bridge"],
            ],
            "impact_profile": "Massive multi-quadrant fragmentation. Emergency medical corridors paralyzed.",
        },
    }

    col_ctrl, col_info = st.columns([1, 2])

    with col_ctrl:
        st.markdown("#### 1. Select Disaster Scenario")
        scenario_name = st.selectbox("Disaster Preset", list(DISASTER_SCENARIOS.keys()), index=0)
        scenario = DISASTER_SCENARIOS[scenario_name]
        st.markdown(f"**Disaster Mechanism:** {scenario['description']}")
        st.markdown(f"**Expected Urban Impact:** `{scenario['impact_profile']}`")

        lm = scenario["landmark"]
        st.markdown(f"**Target Chokepoint:** {lm['name']} (`{lm['lat']}N, {lm['lon']}E`)")

        run_btn = st.button("Execute Disaster Simulation", type="primary", width="stretch")

    with col_info:
        st.markdown("#### 2. Or Click Below to Target a Custom Road Junction")
        st.markdown("Click anywhere on the interactive map to target a specific intersection for severance:")

        m_click = folium.Map(
            location=[config.AOI["center_lat"], config.AOI["center_lon"]],
            zoom_start=config.MAP_ZOOM_START,
            tiles=config.ESRI_TILES,
            attr="Esri World Imagery",
        )
        all_orig_nodes = list(G_original.nodes())
        sample_step = max(1, len(all_orig_nodes) // 500)
        for n in all_orig_nodes[::sample_step]:
            pos = G_original.nodes[n].get("pos", (0, 0))
            folium.CircleMarker(
                location=[pos[1], pos[0]], radius=4,
                color="#3498db", fill=True, fill_opacity=0.7,
                tooltip=f"Junction Node {n}",
            ).add_to(m_click)

        click_result = st_folium(m_click, height=280, width="stretch", returned_objects=["last_clicked"], key="click_map_real")

        custom_node = None
        if click_result and click_result.get("last_clicked"):
            clicked = click_result["last_clicked"]
            click_lat, click_lon = clicked["lat"], clicked["lng"]
            min_dist = float("inf")
            for n in G_original.nodes():
                pos = G_original.nodes[n].get("pos", (0, 0))
                dist = (pos[1] - click_lat) ** 2 + (pos[0] - click_lon) ** 2
                if dist < min_dist:
                    min_dist = dist
                    custom_node = n
            if custom_node is not None:
                st.info(f"Targeted Junction Node **{custom_node}** (closest node to map click)")

    if run_btn or custom_node is not None:
        st.markdown("<div class='section-divider'></div>", unsafe_allow_html=True)
        st.markdown("### Simulation Impact Report & Network Fracture Analysis")

        if custom_node is not None and not run_btn:
            remove_nodes = [custom_node]
            sim_name = f"Custom Severance: Node {custom_node}"
        else:
            sim_name = scenario_name
            landmarks_to_sever = scenario.get("multi_landmarks", [scenario["landmark"]])
            remove_nodes = []
            for target_lm in landmarks_to_sever:
                t_lat, t_lon = target_lm["lat"], target_lm["lon"]
                nodes_sorted = sorted(
                    G_original.nodes(),
                    key=lambda n: (float(G_original.nodes[n].get("lat", 0)) - t_lat) ** 2
                    + (float(G_original.nodes[n].get("lon", 0)) - t_lon) ** 2,
                )
                remove_nodes.extend(nodes_sorted[:4])

        remove_nodes = list(dict.fromkeys(remove_nodes))

        # Intact baselines
        cr_before = 0.9998
        cc_before = 11
        apl_before = 278.25

        G_failed = G_original.copy()
        G_failed.remove_nodes_from(remove_nodes)

        cr_after = compute_connectivity_ratio(G_failed)
        cc_after = nx.number_connected_components(G_failed)
        if len(G_failed) > 0:
            largest_cc_f = max(nx.connected_components(G_failed), key=len)
            sub_f = G_failed.subgraph(largest_cc_f)
            if len(sub_f) > 1:
                sample_sources = list(sub_f.nodes())[:15]
                t_hops = 0
                t_cnt = 0
                for s in sample_sources:
                    sp_lens = nx.single_source_shortest_path_length(sub_f, s)
                    t_hops += sum(sp_lens.values())
                    t_cnt += len(sp_lens) - 1
                apl_after = (t_hops / max(1, t_cnt)) if t_cnt > 0 else apl_before
            else:
                apl_after = 0.0
        else:
            apl_after = float("inf")

        hospital_ref = config.REFERENCE_HUB
        hospital_node = min(
            G_original.nodes(),
            key=lambda n: (float(G_original.nodes[n].get("lat", 0)) - hospital_ref["lat"]) ** 2
            + (float(G_original.nodes[n].get("lon", 0)) - hospital_ref["lon"]) ** 2,
        )

        unreachable_before = len(G_original) - len(nx.node_connected_component(G_original, hospital_node))
        if hospital_node in G_failed:
            unreachable_after = len(G_failed) - len(nx.node_connected_component(G_failed, hospital_node))
        else:
            unreachable_after = len(G_failed)

        st.markdown(f"**Disaster Event:** `{sim_name}` | **Severed Core Nodes:** `{len(remove_nodes)}`")

        # Top-level Real-World Impact KPI Cards
        k1, k2, k3, k4 = st.columns(4)
        k1.metric(
            "Connectivity Retention",
            f"{cr_after*100:.1f}%",
            delta=f"{(cr_after - cr_before)*100:.2f}%",
            delta_color="inverse",
            help="Percentage of total urban network that remains reachable"
        )
        k2.metric(
            "Disconnected Islands",
            f"{cc_after} Sub-Nets",
            delta=f"+{cc_after - cc_before} Isolated",
            delta_color="inverse",
            help="Number of fragmented disconnected network components"
        )
        k3.metric(
            "Detour Commute Overhead",
            f"{apl_after:.1f} Hops",
            delta=f"+{apl_after - apl_before:.1f} Delay",
            delta_color="inverse",
            help="Average routing path length increase caused by severance"
        )
        k4.metric(
            "Cutoff from Victoria Hospital",
            f"{unreachable_after} Nodes",
            delta=f"+{unreachable_after - unreachable_before} Trapped",
            delta_color="inverse",
            help="Number of road intersections unable to reach apex emergency medical trauma care"
        )

        # Actionable Civil Defense & Emergency Response Action Plan
        st.markdown("#### Civil Defense & Emergency Response Advisory")
        st.markdown(f"""
        <div class="info-card">
            <b>Emergency Management Action Directives:</b>
            <ul style="margin-top: 0.4rem; line-height: 1.7;">
                <li><b>Traffic Diversion:</b> Severance of {len(remove_nodes)} arterial junction(s) requires immediate diversion via peripheral ring roads before congestion propagates.</li>
                <li><b>Emergency Medical Isolation:</b> <b>{unreachable_after} road sectors</b> cannot reach Victoria Hospital. Deploy secondary mobile trauma stabilization units to isolated eastern/southern clusters immediately.</li>
                <li><b>Public Transit Re-Routing:</b> BMTC buses and emergency vehicles must avoid the {lm['name']} corridor and use secondary parallel connectors.</li>
            </ul>
        </div>
        """, unsafe_allow_html=True)

        st.markdown("<div class='section-divider'></div>", unsafe_allow_html=True)
        st.markdown("#### Spatial Topography Comparison: Baseline vs. Post-Severance")
        map_b, map_a = st.columns(2)

        with map_b:
            st.markdown("**Baseline (Intact Network - Green)**")
            m_before = folium.Map(
                location=[config.AOI["center_lat"], config.AOI["center_lon"]],
                zoom_start=config.MAP_ZOOM_START + 1,
                tiles=config.ESRI_TILES,
                attr="Esri World Imagery",
            )
            edges_b = list(G_original.edges())
            step_b = max(1, len(edges_b) // 1500)
            for u, v in edges_b[::step_b]:
                pu = G_original.nodes[u].get("pos", (0, 0))
                pv = G_original.nodes[v].get("pos", (0, 0))
                folium.PolyLine(
                    [(pu[1], pu[0]), (pv[1], pv[0])],
                    color="#2ecc71", weight=2.2, opacity=0.85,
                ).add_to(m_before)
            for n in remove_nodes:
                if n in G_original:
                    pos = G_original.nodes[n].get("pos", (0, 0))
                    folium.CircleMarker(
                        [pos[1], pos[0]], radius=8,
                        color="red", fill=True, fill_color="red",
                        tooltip=f"Severed Chokepoint Node {n}",
                    ).add_to(m_before)
            st_folium(m_before, height=420, width="stretch", returned_objects=[], key="map_before_real")

        with map_a:
            st.markdown("**Post-Failure (Severed Red Links + Fragmented Component Colors)**")
            m_after = folium.Map(
                location=[config.AOI["center_lat"], config.AOI["center_lon"]],
                zoom_start=config.MAP_ZOOM_START + 1,
                tiles=config.ESRI_TILES,
                attr="Esri World Imagery",
            )
            edges_a = list(G_failed.edges())
            step_a = max(1, len(edges_a) // 1500)
            for u, v in edges_a[::step_a]:
                pu = G_failed.nodes[u].get("pos", (0, 0))
                pv = G_failed.nodes[v].get("pos", (0, 0))
                folium.PolyLine(
                    [(pu[1], pu[0]), (pv[1], pv[0])],
                    color="#e74c3c", weight=2.2, opacity=0.85,
                ).add_to(m_after)

            component_colors = ["#3498db", "#9b59b6", "#f39c12", "#1abc9c", "#e67e22"]
            top_comps = sorted(nx.connected_components(G_failed), key=len, reverse=True)[:8]
            for i, comp in enumerate(top_comps):
                color = component_colors[i % len(component_colors)]
                for n in list(comp)[:60]:
                    pos = G_failed.nodes[n].get("pos", (0, 0))
                    folium.CircleMarker(
                        [pos[1], pos[0]], radius=4,
                        color=color, fill=True, fill_color=color,
                        tooltip=f"Node {n} - Disconnected Cluster {i + 1}",
                    ).add_to(m_after)
            st_folium(m_after, height=420, width="stretch", returned_objects=[], key="map_after_real")


# ============================================================
# MODULE 5 — URBAN SITE PLANNER & MAIN CITY CORRIDORS
# ============================================================
elif active_tab == "Urban Site Planner & City Corridors":
    st.markdown("### Strategic Urban Site Planner & Vacant Land Advisor")
    st.markdown(
        "Identifies open and underutilized land parcels across Bengaluru, "
        "evaluates arterial connectivity, and computes **real street routes to main city hubs** "
        "to advise constructors and municipal engineers on optimal infrastructure investments."
    )

    st.markdown("""
    <div class="info-card">
        <b>Constructor & Civil Engineering Advisory Seam:</b><br>
        This module assists contractors, developers, and municipal planners in evaluating unbuilt land parcels. 
        It analyzes the <b>surrounding road network</b>, maps the <b>highway ingress access point</b>, 
        and traces <b>active street-level routes into the main city</b> (CBD Core, Majestic Transit Hub, and Victoria Hospital). 
        The recommendation engine ranks optimal infrastructure: Trauma Care, Transit Hubs, Sponge-City Flood Basins, 
        or Logistics Depots with capital expenditure budgets and projected ROI timelines.
    </div>
    """, unsafe_allow_html=True)

    col_sel, col_stats = st.columns([1, 2])

    with col_sel:
        st.markdown("#### Select Vacant Land Parcel")
        parcel_names = [p["name"] for p in VACANT_PARCELS]
        selected_name = st.selectbox("Parcel Selection", parcel_names, index=0)
        selected_parcel = next(p for p in VACANT_PARCELS if p["name"] == selected_name)

        st.markdown(f"**Zone:** {selected_parcel['zone']}")
        st.markdown(f"**Developable Footprint:** `{selected_parcel['area_acres']:.1f} Acres` (~{selected_parcel['area_acres']*0.4047:.1f} Ha)")
        st.markdown(f"**Current Zoning:** `{selected_parcel['zoning']}`")
        st.markdown(f"**Terrain Profile:** {selected_parcel['terrain']}")
        st.caption(selected_parcel["description"])

    eval_result = _get_site_evaluation_cached(selected_parcel["id"])
    if eval_result is None:
        G_active, cent_active = _load_real_graph()
        eval_result = evaluate_site_potential(
            lat=selected_parcel["lat"],
            lon=selected_parcel["lon"],
            area_acres=selected_parcel["area_acres"],
            graph=G_active,
            centrality=cent_active,
        )

    with col_stats:
        st.markdown("#### Geospatial Feasibility Index")
        k1, k2, k3, k4 = st.columns(4)
        k1.metric("Parcel Area", f"{selected_parcel['area_acres']} Ac", help="Total developable parcel footprint")
        k2.metric("Ingress Distance", f"{eval_result['ingress_point']['distance_m']:.0f} m", help="Distance to road network ingress gate")
        k3.metric("Hospital Hub Radius", f"{eval_result['dist_hospital_km']:.1f} km", help="Distance to Victoria Hospital Emergency Trauma Hub")
        k4.metric("Suitability Score", f"{eval_result['primary_recommendation']['suitability_score']}%", delta="High Alignment")

    st.markdown("<div class='section-divider'></div>", unsafe_allow_html=True)
    st.markdown("#### Vacant Land Parcels & Multi-Corridor City Connectivity")

    ctrl_col1, ctrl_col2, ctrl_col3 = st.columns(3)
    show_surrounding = ctrl_col1.checkbox("Show Surrounding Road Network (~1.8km)", value=True)
    show_routes = ctrl_col2.checkbox("Show Routes to Main City Centers", value=True)
    show_ingress = ctrl_col3.checkbox("Show Site Ingress Point", value=True)

    m_vacant = folium.Map(
        location=[selected_parcel["lat"], selected_parcel["lon"]],
        zoom_start=13,
        tiles=config.ESRI_TILES,
        attr="Esri World Imagery",
    )

    # 1. Surrounding Road Network Markings (Crisp Glowing Cyan Lines)
    if show_surrounding and eval_result.get("surrounding_roads"):
        road_group = folium.FeatureGroup(name="Surrounding Road Network")
        folium.PolyLine(
            locations=eval_result["surrounding_roads"],
            color="#00d2d3",
            weight=2.5,
            opacity=0.88,
            tooltip="Local Road Network Segment",
        ).add_to(road_group)
        road_group.add_to(m_vacant)

    # 2. Main City Connector Routes (Distinct Strategic Corridors)
    if show_routes and eval_result.get("main_city_routes"):
        routes_group = folium.FeatureGroup(name="Main City Arterial Corridors")
        for hub_key, route in eval_result["main_city_routes"].items():
            route_coords = route.get("path_coords", route.get("coordinates", []))
            if route_coords:
                folium.PolyLine(
                    locations=route_coords,
                    color=route.get("color", "#3498db"),
                    weight=5.0,
                    opacity=0.92,
                    tooltip=f"{route.get('corridor_name', 'Corridor')} ({route.get('distance_km', 0)} km, ~{route.get('est_time_min', route.get('estimated_time_min', 0))} min)",
                ).add_to(routes_group)
        routes_group.add_to(m_vacant)

    # 3. Draw All Vacant Parcels
    for p in VACANT_PARCELS:
        is_selected = (p["id"] == selected_parcel["id"])
        color = "#e74c3c" if is_selected else "#f39c12"
        fill_color = "#e74c3c" if is_selected else "#f1c40f"
        fill_opacity = 0.6 if is_selected else 0.35
        weight = 3 if is_selected else 1.5

        folium.Polygon(
            locations=p["polygon"],
            color=color,
            weight=weight,
            fill=True,
            fill_color=fill_color,
            fill_opacity=fill_opacity,
            tooltip=f"{p['name']} ({p['area_acres']} Ac)",
            popup=f"<b>{p['name']}</b><br>Area: {p['area_acres']} Acres<br>Zoning: {p['zoning']}",
        ).add_to(m_vacant)

    # 4. Site Ingress Gate Marker
    if show_ingress and "ingress_point" in eval_result:
        ing = eval_result["ingress_point"]
        folium.Marker(
            location=[ing["lat"], ing["lon"]],
            icon=folium.Icon(color="orange", icon="sign-in", prefix="fa"),
            tooltip=f"Site Highway Ingress Gate ({ing['distance_m']:.0f}m from parcel centroid)",
            popup=f"<b>Site Ingress Gate</b><br>Connecting Road: {eval_result['nearest_landmark']}<br>Distance: {ing['distance_m']:.0f} m",
        ).add_to(m_vacant)
        folium.PolyLine(
            locations=[[selected_parcel["lat"], selected_parcel["lon"]], [ing["lat"], ing["lon"]]],
            color="#f39c12",
            weight=3,
            dash_array="6",
            tooltip="Ingress Connection Spur",
        ).add_to(m_vacant)

    # 5. City Hub Destination Markers
    for h_k, h_v in MAIN_CITY_HUBS.items():
        folium.Marker(
            location=[h_v["lat"], h_v["lon"]],
            icon=folium.Icon(color="purple" if h_k == "CBD_CORE" else ("blue" if h_k == "MAJESTIC_HUB" else "red"), icon=h_v["icon"], prefix="fa"),
            tooltip=f"{h_v['name']} ({h_v['corridor_name']})",
            popup=f"<b>{h_v['name']}</b><br>{h_v['corridor_name']}",
        ).add_to(m_vacant)

    folium.LayerControl().add_to(m_vacant)
    st_folium(m_vacant, height=520, width="stretch", returned_objects=[], key="map_vacant_real")

    # City Connectivity Table
    if eval_result.get("main_city_routes"):
        st.markdown("#### Main City Arterial Connectivity & Ingress Breakdown")
        route_table_data = []
        for h_k, route in eval_result["main_city_routes"].items():
            route_table_data.append({
                "Destination Hub": route.get("hub_name", route.get("name", "City Hub")),
                "Strategic Connecting Corridor": route.get("corridor_name", "Connecting Corridor"),
                "Street Distance": f"{route.get('distance_km', 0)} km",
                "Transit Time (Normal)": f"~{route.get('est_time_min', route.get('estimated_time_min', 0))} min",
                "Traversed Gatekeeper Bottlenecks": f"{route.get('gatekeepers_crossed', 0)} Chokepoint(s)",
            })
        st.dataframe(pd.DataFrame(route_table_data), width="stretch", hide_index=True)

    # Constructor Recommendation Card
    st.markdown("<div class='section-divider'></div>", unsafe_allow_html=True)
    st.markdown("### Constructor Development Advisory & Feasibility Matrix")

    prim = eval_result["primary_recommendation"]
    if prim:
        st.markdown(f"""
        <div style="background: linear-gradient(135deg, #101c3d 0%, #172a59 100%); padding: 1.6rem 2rem; border-radius: 14px; border-left: 6px solid {prim['badge_color']}; box-shadow: 0 6px 20px rgba(0,0,0,0.35); margin-bottom: 1.5rem; border: 1px solid #23355d; border-left-width: 6px;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.8rem;">
                <span style="font-size: 1.3rem; font-weight: 800; color: #ffffff;">{prim['type']}</span>
                <span style="background-color: {prim['badge_color']}; color: white; padding: 0.35rem 0.9rem; border-radius: 20px; font-weight: 700; font-size: 0.88rem;">Suitability Score: {prim['suitability_score']}/100</span>
            </div>
            <p style="color: #00d2d3; font-weight: 700; margin-top: 0.4rem; font-size: 0.95rem;">Category: {prim['category']}</p>
            <p style="color: #cbd5e1; line-height: 1.65; margin-top: 0.8rem; font-size: 1.02rem;">{prim['rationale']}</p>
            <div style="display: flex; gap: 2.5rem; margin-top: 1.2rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem; flex-wrap: wrap;">
                <div><span style="color: #94a3b8; font-size: 0.82rem; text-transform: uppercase; font-weight: 600;">Estimated CAPEX:</span><br><b style="color: #ffffff; font-size: 1.15rem;">{prim['est_budget_cr']}</b></div>
                <div><span style="color: #94a3b8; font-size: 0.82rem; text-transform: uppercase; font-weight: 600;">Target ROI Horizon:</span><br><b style="color: #ffffff; font-size: 1.15rem;">{prim['roi_timeline']}</b></div>
                <div><span style="color: #94a3b8; font-size: 0.82rem; text-transform: uppercase; font-weight: 600;">Resilience Impact:</span><br><b style="color: #00d2d3; font-size: 1.05rem;">{prim['resilience_impact']}</b></div>
            </div>
        </div>
        """, unsafe_allow_html=True)

    # DPR Expander
    with st.expander("View Constructor Detailed Project Report (DPR) Brief"):
        dpr_text = f"""# DETAILED PROJECT REPORT (DPR) BRIEF
Site Identifier: {selected_parcel['id']} - {selected_parcel['name']}
Geographic Coordinates: {selected_parcel['lat']}N, {selected_parcel['lon']}E
Total Footprint: {selected_parcel['area_acres']:.1f} Acres (~{selected_parcel['area_acres']*0.4047:.2f} Ha)
Target Plan: {prim['type']}

1. Executive Site Assessment
- Nearest Arterial Junction: {eval_result['ingress_point']['distance_m']:.0f} meters (Direct Ingress Access)
- Distance to Central Medical Hub: {eval_result['dist_hospital_km']:.2f} km
