            color = "#D4FF00"
            weight = 1.6
            opacity = 0.72

        folium.PolyLine(
            locations=locs,
            color=color,
            weight=weight,
            opacity=opacity,
            tooltip=f"Road {u_str}-{v_str} | Centrality: {edge_cent:.5f}",
        ).add_to(m_home)

    # Highlight top critical road intersections in Hot Pink with Chartreuse core
